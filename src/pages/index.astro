<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Forge Midwest — NetSuite ERP Consulting for Midwest Manufacturers</title>
  <meta name="description" content="Forge Midwest bridges your shop floor automation, SCADA/MES systems, and ERP into a unified data layer. NetSuite consulting and operational data architecture for Midwest manufacturers." />
  <meta name="keywords" content="NetSuite consultant Michigan, ERP integration manufacturing midwest, NetSuite implementation, SCADA ERP integration, manufacturing ERP consultant, Ignition ERP, operational data architecture" />
  <link rel="canonical" href="https://forgemidwest.com" />
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=IBM+Plex+Mono:wght@400;500&family=Source+Serif+4:ital,wght@0,300;0,400;0,600;1,300;1,400&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --black:   #0a0b0c;
      --steel:   #141618;
      --iron:    #1e2023;
      --smoke:   #2e3136;
      --ash:     #5a5f6a;
      --silver:  #9ba0ac;
      --mist:    #c8cdd8;
      --white:   #ede9e2;
      --ember:   #b84f1a;
      --forge:   #d06828;
      --glow:    #e8893c;
      --gold:    #c8982a;
      --teal:    #2a7a6a;
    }

    html { scroll-behavior: smooth; }

    body {
      background: var(--black);
      color: var(--white);
      font-family: 'Source Serif 4', Georgia, serif;
      overflow-x: hidden;
      line-height: 1.65;
    }

    /* Grain overlay */
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 300 300' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.75' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
      opacity: 0.03;
      pointer-events: none;
      z-index: 999;
    }

    /* ── NAVIGATION ── */
    nav {
      position: fixed;
      top: 0; left: 0; right: 0;
      z-index: 200;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 1.1rem 3rem;
      background: rgba(10,11,12,0.94);
      backdrop-filter: blur(14px);
      border-bottom: 1px solid rgba(208,104,40,0.15);
    }

    .nav-logo {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 1.45rem;
      letter-spacing: 0.18em;
      color: var(--white);
      text-decoration: none;
      display: flex;
      align-items: center;
      gap: 0.6rem;
    }

    .nav-logo-icon {
      width: 26px;
      height: 26px;
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .nav-logo-icon svg {
      width: 26px;
      height: 26px;
    }

    .nav-dot {
      color: var(--forge);
    }

    nav ul {
      list-style: none;
      display: flex;
      gap: 2rem;
    }

    nav ul a {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.7rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--silver);
      text-decoration: none;
      transition: color 0.2s;
    }

    nav ul a:hover { color: var(--glow); }

    .nav-cta {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.68rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--white) !important;
      border: 1px solid rgba(208,104,40,0.6);
      padding: 0.45rem 1rem;
      border-radius: 2px;
      transition: background 0.2s, border-color 0.2s !important;
    }

    .nav-cta:hover {
      background: rgba(208,104,40,0.15) !important;
      border-color: var(--forge) !important;
    }

    /* ── HERO ── */
    #hero {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 10rem 3rem 6rem;
      position: relative;
      overflow: hidden;
    }

    .hero-bg {
      position: absolute;
      inset: 0;
      background:
        radial-gradient(ellipse 70% 60% at 80% 40%, rgba(184,79,26,0.07) 0%, transparent 70%),
        radial-gradient(ellipse 50% 50% at 20% 70%, rgba(208,104,40,0.04) 0%, transparent 60%),
        linear-gradient(160deg, var(--black) 0%, #0f1012 60%, #0d0e0f 100%);
    }

    .hero-grid-lines {
      position: absolute;
      inset: 0;
      background-image:
        linear-gradient(rgba(208,104,40,0.04) 1px, transparent 1px),
        linear-gradient(90deg, rgba(208,104,40,0.04) 1px, transparent 1px);
      background-size: 60px 60px;
      mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black 20%, transparent 80%);
    }

    .hero-inner {
      position: relative;
      max-width: 900px;
    }

    .hero-eyebrow {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.7rem;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--forge);
      margin-bottom: 1.8rem;
      display: flex;
      align-items: center;
      gap: 0.8rem;
    }

    .hero-eyebrow::before {
      content: '';
      display: inline-block;
      width: 32px;
      height: 1px;
      background: var(--forge);
    }

    h1 {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: clamp(3rem, 6vw, 5.2rem);
      font-weight: 700;
      line-height: 1.08;
      letter-spacing: -0.01em;
      margin-bottom: 1.4rem;
      color: var(--white);
    }

    h1 em {
      font-style: italic;
      color: var(--glow);
    }

    .hero-sub {
      font-size: 1.15rem;
      color: var(--silver);
      max-width: 580px;
      line-height: 1.7;
      margin-bottom: 2.8rem;
      font-weight: 300;
    }

    .hero-actions {
      display: flex;
      gap: 1rem;
      align-items: center;
      flex-wrap: wrap;
    }

    .btn-primary {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.75rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--black);
      background: var(--forge);
      padding: 0.85rem 1.8rem;
      border-radius: 2px;
      text-decoration: none;
      transition: background 0.2s, transform 0.15s;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }

    .btn-primary:hover {
      background: var(--glow);
      transform: translateY(-1px);
    }

    .btn-ghost {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.72rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--silver);
      border: 1px solid var(--smoke);
      padding: 0.85rem 1.8rem;
      border-radius: 2px;
      text-decoration: none;
      transition: border-color 0.2s, color 0.2s;
    }

    .btn-ghost:hover {
      border-color: var(--forge);
      color: var(--white);
    }

    .hero-stat-row {
      position: absolute;
      bottom: 3.5rem;
      left: 3rem;
      right: 3rem;
      display: flex;
      gap: 3rem;
      padding-top: 2rem;
      border-top: 1px solid rgba(255,255,255,0.06);
    }

    .hero-stat {
      font-family: 'IBM Plex Mono', monospace;
    }

    .hero-stat-num {
      font-size: 1.8rem;
      color: var(--forge);
      letter-spacing: -0.02em;
      line-height: 1;
      margin-bottom: 0.3rem;
    }

    .hero-stat-label {
      font-size: 0.65rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--ash);
    }

    /* ── SECTION SHARED ── */
    section { position: relative; }

    .section-label {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.65rem;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--forge);
      margin-bottom: 1.2rem;
      display: flex;
      align-items: center;
      gap: 0.7rem;
    }

    .section-label::before {
      content: '';
      display: inline-block;
      width: 24px;
      height: 1px;
      background: var(--forge);
    }

    h2 {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: clamp(2rem, 3.5vw, 3rem);
      font-weight: 700;
      line-height: 1.15;
      color: var(--white);
    }

    h2 em { font-style: italic; color: var(--glow); }

    .inner {
      max-width: 1100px;
      margin: 0 auto;
      padding: 0 3rem;
    }

    /* ── BRIDGE SECTION ── */
    #bridge {
      padding: 7rem 0;
      background: var(--steel);
      border-top: 1px solid rgba(208,104,40,0.1);
      border-bottom: 1px solid rgba(208,104,40,0.1);
    }

    .bridge-header {
      text-align: center;
      max-width: 680px;
      margin: 0 auto 4.5rem;
    }

    .bridge-header p {
      margin-top: 1.2rem;
      color: var(--silver);
      font-size: 1.05rem;
      font-weight: 300;
    }

    .bridge-diagram {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      gap: 0;
      align-items: center;
      max-width: 900px;
      margin: 0 auto;
    }

    .bridge-side {
      background: var(--iron);
      border: 1px solid var(--smoke);
      border-radius: 4px;
      padding: 2rem;
    }

    .bridge-side-label {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.62rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--ash);
      margin-bottom: 1.2rem;
    }

    .bridge-item {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.6rem 0;
      border-bottom: 1px solid rgba(255,255,255,0.04);
      font-size: 0.9rem;
      color: var(--mist);
    }

    .bridge-item:last-child { border-bottom: none; }

    .bridge-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--smoke);
      flex-shrink: 0;
    }

    .bridge-dot.active { background: var(--forge); }

    .bridge-center {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0;
      padding: 0 1rem;
      position: relative;
    }

    .bridge-arrow-line {
      height: 2px;
      width: 100%;
      background: linear-gradient(90deg, transparent, var(--forge), transparent);
    }

    .bridge-core {
      width: 120px;
      height: 120px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(208,104,40,0.2) 0%, rgba(184,79,26,0.05) 60%, transparent 100%);
      border: 1px solid rgba(208,104,40,0.4);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      position: relative;
    }

    .bridge-core::before {
      content: '';
      position: absolute;
      inset: -8px;
      border-radius: 50%;
      border: 1px dashed rgba(208,104,40,0.2);
      animation: spin 30s linear infinite;
    }

    @keyframes spin { to { transform: rotate(360deg); } }

    .bridge-core-text {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 1rem;
      letter-spacing: 0.1em;
      color: var(--glow);
      line-height: 1.2;
    }

    .bridge-core-sub {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.52rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--ash);
      margin-top: 0.3rem;
    }

    .bridge-arrows {
      display: flex;
      align-items: center;
      gap: 0;
      width: 100%;
      justify-content: center;
    }

    .bridge-connector {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1rem;
      padding: 0 2rem;
    }

    .bridge-connector-line {
      height: 2px;
      width: 60px;
      background: linear-gradient(90deg, var(--smoke), var(--forge), var(--smoke));
    }

    /* ── PROBLEM STATEMENT ── */
    #problem {
      padding: 7rem 0;
    }

    .problem-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 5rem;
      align-items: start;
      margin-top: 3.5rem;
    }

    .problem-copy p {
      color: var(--silver);
      font-size: 1.05rem;
      margin-bottom: 1.2rem;
      font-weight: 300;
      line-height: 1.75;
    }

    .problem-copy p strong {
      color: var(--white);
      font-weight: 600;
    }

    .problem-quote {
      background: var(--iron);
      border-left: 3px solid var(--forge);
      padding: 2rem 2rem 2rem 2.2rem;
      margin-top: 2rem;
      border-radius: 0 4px 4px 0;
    }

    .problem-quote p {
      font-family: 'Playfair Display', Georgia, serif;
      font-style: italic;
      font-size: 1.15rem;
      color: var(--white);
      line-height: 1.6;
      margin: 0;
    }

    .problem-quote cite {
      display: block;
      margin-top: 1rem;
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.65rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--forge);
      font-style: normal;
    }

    .problem-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 1.2rem;
    }

    .problem-list li {
      display: flex;
      gap: 1rem;
      align-items: flex-start;
      padding: 1.4rem;
      background: var(--iron);
      border: 1px solid var(--smoke);
      border-radius: 4px;
      transition: border-color 0.2s;
    }

    .problem-list li:hover { border-color: rgba(208,104,40,0.3); }

    .problem-list-icon {
      width: 36px;
      height: 36px;
      background: rgba(208,104,40,0.1);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      color: var(--forge);
      font-size: 0.9rem;
    }

    .problem-list-text strong {
      display: block;
      font-size: 0.9rem;
      color: var(--white);
      margin-bottom: 0.3rem;
    }

    .problem-list-text span {
      font-size: 0.85rem;
      color: var(--ash);
      line-height: 1.5;
    }

    /* ── SERVICES ── */
    #services {
      padding: 7rem 0;
      background: var(--steel);
      border-top: 1px solid rgba(208,104,40,0.08);
    }

    .services-header {
      max-width: 620px;
      margin-bottom: 4rem;
    }

    .services-header p {
      margin-top: 1.1rem;
      color: var(--silver);
      font-weight: 300;
    }

    .services-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5px;
      background: var(--smoke);
      border: 1px solid var(--smoke);
      border-radius: 6px;
      overflow: hidden;
      margin-bottom: 4rem;
    }

    .service-card {
      background: var(--iron);
      padding: 2.2rem;
      transition: background 0.2s;
    }

    .service-card:hover { background: #242628; }

    .service-num {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.65rem;
      color: var(--forge);
      letter-spacing: 0.1em;
      margin-bottom: 1.2rem;
    }

    .service-card h3 {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 1.1rem;
      color: var(--white);
      margin-bottom: 0.7rem;
      line-height: 1.3;
    }

    .service-card p {
      font-size: 0.88rem;
      color: var(--ash);
      line-height: 1.65;
    }

    /* ── ENGAGEMENT TIERS ── */
    .tiers-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
      margin-top: 2rem;
    }

    .tier-card {
      border: 1px solid var(--smoke);
      border-radius: 6px;
      padding: 2.5rem;
      background: var(--iron);
      position: relative;
      overflow: hidden;
    }

    .tier-card.featured {
      border-color: rgba(208,104,40,0.4);
    }

    .tier-card.featured::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 2px;
      background: linear-gradient(90deg, var(--ember), var(--forge), var(--glow));
    }

    .tier-badge {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.6rem;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--forge);
      margin-bottom: 0.8rem;
    }

    .tier-card h3 {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 1.5rem;
      margin-bottom: 0.5rem;
      color: var(--white);
    }

    .tier-card .tier-sub {
      font-size: 0.88rem;
      color: var(--ash);
      margin-bottom: 1.8rem;
      line-height: 1.55;
    }

    .tier-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 0.7rem;
    }

    .tier-list li {
      font-size: 0.88rem;
      color: var(--silver);
      display: flex;
      align-items: center;
      gap: 0.7rem;
    }

    .tier-list li::before {
      content: '→';
      color: var(--forge);
      font-size: 0.8rem;
      flex-shrink: 0;
    }

    /* ── BLUEPRINT ── */
    #blueprint {
      padding: 7rem 0;
    }

    .blueprint-layout {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 5rem;
      align-items: start;
      margin-top: 3.5rem;
    }

    .blueprint-copy h3 {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 1.3rem;
      color: var(--glow);
      font-style: italic;
      margin-bottom: 1.2rem;
    }

    .blueprint-copy p {
      color: var(--silver);
      font-size: 0.98rem;
      line-height: 1.75;
      margin-bottom: 1.1rem;
      font-weight: 300;
    }

    .blueprint-deliverables {
      margin-top: 2rem;
      display: flex;
      flex-direction: column;
      gap: 0.8rem;
    }

    .deliverable-item {
      display: flex;
      align-items: center;
      gap: 0.8rem;
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.78rem;
      color: var(--mist);
    }

    .deliverable-item::before {
      content: '◆';
      color: var(--forge);
      font-size: 0.55rem;
    }

    .blueprint-weeks {
      display: flex;
      flex-direction: column;
      gap: 0;
    }

    .week-block {
      border: 1px solid var(--smoke);
      border-bottom: none;
      padding: 1.8rem 2rem;
      background: var(--iron);
      position: relative;
    }

    .week-block:first-child { border-radius: 6px 6px 0 0; }
    .week-block:last-child {
      border-bottom: 1px solid var(--smoke);
      border-radius: 0 0 6px 6px;
    }

    .week-label {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.62rem;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--forge);
      margin-bottom: 0.5rem;
    }

    .week-block h4 {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 1.1rem;
      color: var(--white);
      margin-bottom: 0.5rem;
    }

    .week-block p {
      font-size: 0.85rem;
      color: var(--ash);
      line-height: 1.6;
    }

    .blueprint-cta {
      margin-top: 2rem;
    }

    /* ── EXPERTISE ── */
    #expertise {
      padding: 7rem 0;
      background: var(--steel);
      border-top: 1px solid rgba(208,104,40,0.08);
    }

    .expertise-header {
      max-width: 580px;
      margin-bottom: 4rem;
    }

    .expertise-header p {
      margin-top: 1.1rem;
      color: var(--silver);
      font-weight: 300;
    }

    .expertise-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1.5px;
      background: var(--smoke);
      border: 1px solid var(--smoke);
      border-radius: 6px;
      overflow: hidden;
      margin-bottom: 3rem;
    }

    .expertise-card {
      background: var(--iron);
      padding: 2rem;
      transition: background 0.2s;
    }

    .expertise-card:hover { background: #242628; }

    .expertise-icon {
      font-size: 1.4rem;
      margin-bottom: 1rem;
    }

    .expertise-card h3 {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.75rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--glow);
      margin-bottom: 0.6rem;
    }

    .expertise-card p {
      font-size: 0.83rem;
      color: var(--ash);
      line-height: 1.6;
    }

    .cert-row {
      display: flex;
      gap: 0.8rem;
      flex-wrap: wrap;
    }

    .cert-badge {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.68rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--silver);
      border: 1px solid var(--smoke);
      padding: 0.4rem 0.9rem;
      border-radius: 2px;
      background: var(--iron);
    }

    /* ── WHO WE ARE ── */
    #about {
      padding: 7rem 0;
    }

    .about-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 5rem;
      align-items: center;
      margin-top: 3rem;
    }

    .about-copy p {
      color: var(--silver);
      font-size: 1rem;
      line-height: 1.8;
      margin-bottom: 1.2rem;
      font-weight: 300;
    }

    .about-copy p strong {
      color: var(--white);
      font-weight: 600;
    }

    .about-pillars {
      display: flex;
      flex-direction: column;
